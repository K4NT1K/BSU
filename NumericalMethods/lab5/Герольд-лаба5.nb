Cell["\<\
1.3;
Gr1 = ListPlot[Tbl, PlotStyle -> {PointSize[0.02]}];
Gr2 = Plot[f[x], {x, a, b}];
Gr3 = Plot[P[x], {x, a, b}, PlotStyle -> {Gray, Dashed}];
Show[Gr1, Gr2, Gr3]\
\>", "Input",ExpressionUUID->"0db1f2db-47c5-0a46-8d15-856cb5f9c6f3"],

