Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 3", "Text",ExpressionUUID->"bd377ec7-1c20-ed46-99c7-4fd0f1aadfcb"],

Cell["\<\
Clear[n, M, f, a, b, omega];
f[x_] = Sin[x];
a = 0; b = Pi/4; epsilon = 10^(-2);
Subscript[x, i_] := a + i*(b - a)/n;
n = 1;
While[
  (M = Maximize[{Abs[D[f[x], {x, n + 1}]], a <= x <= b}, x][[1]];
   omega[y_] = Product[y - Subscript[x, i], {i, 0, n}];
   Pomega = Maximize[{Abs[omega[y]], a <= y <= b}, y][[1]];
   N[M*Pomega/((n + 1)!)] > epsilon),
  n++];
Print[\"\:0422\:0440\:0435\:0431\:0443\:0435\:043c\:0430\:044f \:0441\:0442\
\:0435\:043f\:0435\:043d\:044c n = \", n, \"; \:043c\:0438\:043d\:0438\:043c\
\:0430\:043b\:044c\:043d\:043e\:0435 \:0447\:0438\:0441\:043b\:043e \:0443\
\:0437\:043b\:043e\:0432 = \", n + 1];
R = N[M*Pomega/((n + 1)!)];
Print[\"\:041e\:0442\:0432\:0435\:0442: \:0447\:0438\:0441\:043b\:043e \:0440\
\:0430\:0432\:043d\:043e\:043e\:0442\:0441\:0442\:043e\:044f\:0449\:0438\:0445\
 \:0443\:0437\:043b\:043e\:0432 \", n + 1, \", \:043e\:0446\:0435\:043d\:043a\
\:0430 R <= \", R]\
\>", "Input",ExpressionUUID->"a88eb56c-24b4-b947-9c7c-a9d83dbda6a9"],

