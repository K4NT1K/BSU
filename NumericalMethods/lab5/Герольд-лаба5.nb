Cell["\<\
1.2;
M1 = Maximize[{D[f[x], {x, n + 1}], a <= x <= b}, x][[1]];
M2 = Minimize[{D[f[x], {x, n + 1}], a <= x <= b}, x][[1]];
M = Max[Abs[M1], Abs[M2]];
R = M/(((n + 1)!)*2^n) // N
Print[\"\:041e\:0442\:0432\:0435\:0442: \:043e\:0446\:0435\:043d\:043a\:0430 \
\:043f\:043e\:0433\:0440\:0435\:0448\:043d\:043e\:0441\:0442\:0438 R <= \", R]\
\>", "Input",ExpressionUUID->"b9c00e3b-71d6-4c49-b487-4cf48fdce6d9"],

