 \:0443\:0437\:043b\:043e\:0432 \"", "9", 
   "\", \:043e\:0446\:0435\:043d\:043a\:0430 R <= \"", 
   "0.005429916744262952`"},
  "RowDefault"]], "Print",ExpressionUUID->"2b0e1e4b-f6fd-e344-a252-\
732c00a91c77"],

Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 4", "Text",ExpressionUUID->"1e3a51d8-1f77-dd4c-9da2-2255eb2b2431"],

Cell["\<\
Clear[n, M, f, a, b];
f[x_] = Cos[x];
a = Pi/2; b = 3 Pi/4; n = 2;
M = Maximize[{Abs[D[f[x], {x, n + 1}]], a <= x <= b}, x][[1]];
R = M*(b - a)^(n + 1)/(((n + 1)!)*2^(2 n + 1)) // N;
Print[\"\:041e\:0442\:0432\:0435\:0442: \:043e\:0446\:0435\:043d\:043a\:0430 \
\:043f\:043e\:0433\:0440\:0435\:0448\:043d\:043e\:0441\:0442\:0438 \:043f\
\:043e \:043e\:043f\:0442\:0438\:043c\:0430\:043b\:044c\:043d\:044b\:043c \
\:0443\:0437\:043b\:0430\:043c R <= \", R]\
\>", "Input",ExpressionUUID->"60e58675-966d-6540-a1ed-0c1a22fa813a"],

