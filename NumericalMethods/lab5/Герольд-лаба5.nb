 TemplateBox[{
  "\"\:0422\:0440\:0435\:0431\:0443\:0435\:043c\:0430\:044f \
\:0441\:0442\:0435\:043f\:0435\:043d\:044c n = \"", "8", 
   "\"; \:043c\:0438\:043d\:0438\:043c\:0430\:043b\:044c\:043d\:043e\:0435 \
\:0447\:0438\:0441\:043b\:043e \:0443\:0437\:043b\:043e\:0432 = \"", "9"},
  "RowDefault"]], "Print",ExpressionUUID->"9363f1e5-651f-1048-91a6-\
f863ba1eb901"],

