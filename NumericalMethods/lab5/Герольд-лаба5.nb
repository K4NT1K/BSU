Notebook[{
Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"af193e8a-329c-2444-80f9-40f7dd64f8eb"],

Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 1", "Text",ExpressionUUID->"ea9a82e4-93dc-6f4f-a621-9fa8930b4d5f"],

Cell["\<\
1.1;
a = -1; b = 1;
f[x_] = 3^x;
n = 4;
Do[{Subscript[x, i] = Cos[Pi*(2*i + 1)/(2*(n + 1))], Subscript[f, i] = \
f[Subscript[x, i]]}, {i, 0, n}]\
\>", "Input",ExpressionUUID->"1a560b53-ff38-7d4a-802b-4cfea32a2d99"],

Cell["\<\
P[x_] = Sum[Product[(x - Subscript[x, i])/(Subscript[x, k] - Subscript[x, \
i]), {i, 0, k - 1}]*Product[(x - Subscript[x, i])/(Subscript[x, k] - \
Subscript[x, i]), {i, k + 1, n}]*Subscript[f, k], {k, 0, n}] // Simplify // \
Expand\
\>", "Input",ExpressionUUID->"7b7f3227-511b-c145-8767-b5afecf308e9"],

