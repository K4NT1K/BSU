Cell["\<\
Tbl = Table[{Subscript[x, i], Subscript[f, i]}, {i, 0, n}];
Pl[x_] = InterpolatingPolynomial[Tbl, x] // Simplify // Expand
Simplify[P[x] - Pl[x]] == 0\
\>", "Input",ExpressionUUID->"777ee4f2-ed75-a84f-839d-b9beb264c1a3"],

