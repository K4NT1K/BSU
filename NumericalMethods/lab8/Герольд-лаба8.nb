Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 3", "Text",ExpressionUUID->"28944f9a-f1b4-a242-b0f8-e1d2b1d84c27"],

Cell["\<\
XX = {1/10, 2/10, 3/10, 4/10}; ff = {1.26, 2.864, 6.885, 9.764};
n = Length[XX] - 1; Subscript[xx, k_] := XX[[k + 1]]; Subscript[f, k_] := \
ff[[k + 1]];
eqv[m_, y_] := Table[(D[x^i, {x, m}] /. x -> y) == Sum[Subscript[d, \
k]*Subscript[xx, k]^i, {k, 0, n}], {i, 0, n}];
Pr[m_, y_] := Sum[Subscript[d, k]*Subscript[f, k], {k, 0, n}] /. \
(Solve[eqv[m, y], {}] // Flatten);
{Pr[1, 1/10], Pr[1, 2/10], Pr[2, 0], Pr[3, 5/10]}\
\>", "Input",ExpressionUUID->"5b2ac74b-8494-8748-a5b2-84c8406ca264"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "7.908333333333317`"}], ",", "34.05666666666666`", ",", 
   "953.5`", ",", 
   RowBox[{"-", "3559.`"}]}], "}"}]], "Output",ExpressionUUID->"08740bdd-90a1-\
6c4f-b6fc-133c02820ae3"],

Cell["\<\
P[x_] = InterpolatingPolynomial[Table[{Subscript[xx, k], Subscript[f, k]}, \
{k, 0, n}], x];
Pr1[m_, y_] := D[P[x], {x, m}] /. x -> y;
{Pr1[1, 1/10] == Pr[1, 1/10], Pr1[1, 2/10] == Pr[1, 2/10], Pr1[2, 0] == Pr[2, \
0], Pr1[3, 5/10] == Pr[3, 5/10]}\
\>", "Input",ExpressionUUID->"ca3a16ff-75c0-ea40-b4ff-fa268ef39e7c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output",Ex\
pressionUUID->"66de6340-b5e8-b643-b1c4-d6bd6a9ecab1"],

Cell["\<\
Pogr[m_, y_] := M/((n + 1)!)*Abs[D[Product[(x - Subscript[xx, k]), {k, 0, \
n}], {x, m}] /. x -> y];
{Pogr[1, 1/10], Pogr[1, 2/10], Pogr[2, 0], Pogr[3, 5/10]}\
\>", "Input",ExpressionUUID->"9ee1a2d6-bd6f-284a-92a2-07d047c8069f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["M", "4000"], ",", 
   FractionBox["M", "12000"], ",", 
   FractionBox[
    RowBox[{"7", " ", "M"}], "240"], ",", 
   FractionBox["M", "4"]}], "}"}]], "Output",ExpressionUUID->"995bcb7a-f9ea-\
db42-827d-8842cd054c31"],

Cell["\<\
Table[M/((n + 1)!)*Maximize[{Abs[D[Product[(x - Subscript[xx, k]), {k, 0, \
n}], {x, m}]], 0 <= x <= 5/10}, x][[1]], {m, 0, n + 2}]\
\>", "Input",ExpressionUUID->"cff5b816-8999-b842-87ac-6dcd32b3825d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["M", "10000"], ",", 
   FractionBox["M", "480"], ",", 
   FractionBox[
    RowBox[{"7", " ", "M"}], "240"], ",", 
   FractionBox["M", "4"], ",", "M", ",", "0"}], "}"}]], "Output",ExpressionUUI\
D->"d4bda461-d339-7c47-91a9-2dabaabf3bb1"]
},
