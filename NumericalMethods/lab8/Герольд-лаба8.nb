Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 2", "Text",ExpressionUUID->"260ca560-b7eb-174d-ba19-c08405093e0f"],

Cell["\<\
Clear[T, n, NN, X, F, koef];
f[x_] = 6 Tan[x]^2;
NN = 7;
X = Table[Subscript[x, k] = 2 Pi*k/NN, {k, 0, NN - 1}];
F = f[X];
Subscript[f, k_] := F[[k + 1]];
n = (NN - 1)/2;
Do[Subscript[C, k] = (1/NN)*Sum[Subscript[f, j]*Exp[I*2 Pi/NN]^(-k*j), {j, 0, \
NN - 1}], {k, -n, n}];
T[x_] = Sum[Subscript[C, k]*Exp[I*x]^k, {k, -n, n}] // FullSimplify
Table[Chop[T[Subscript[x, j]] - Subscript[f, j]] == 0, {j, 0, NN - 1}]
Gr1 = ListPlot[MapThread[List, {X, F}], PlotStyle -> {PointSize[0.02]}];
Gr2 = Plot[f[y], {y, Subscript[x, 0], Subscript[x, NN - 1]}];
Gr3 = Plot[T[y], {y, Subscript[x, 0], Subscript[x, NN - 1]}, PlotStyle -> Red];
Show[Gr1, Gr2, Gr3, PlotRange -> All]\
\>", "Input",ExpressionUUID->"86ef5f20-6894-834a-9b06-8056b3d74960"],

