Notebook[{
Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"6891ca13-b98b-6c41-83f3-2f3e0aaa4970"],

Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 1", "Text",ExpressionUUID->"6e141d92-285c-724f-bf2c-aca5d2598211"],

Cell["\<\
Clear[P, PP, PPP, A, B, eq, koef, T, X, F, NN, n, xx, spl1, spl2, spl3];
f[x_] = 6 Tan[x]^2;
X = {0, Pi/6, Pi/4, Pi/3, Pi/12, Pi, 9 Pi/5}; xx = Pi/9;
F = f[X];
Subscript[x, k_] := X[[k + 1]];
Subscript[f, k_] := F[[k + 1]];
NN = Length[X];
n = (NN - 1)/2;
koef = Solve[Table[Subscript[a, 0] + Sum[Subscript[a, k] Sin[k*Subscript[x, \
j]] + Subscript[b, k] Cos[k*Subscript[x, j]], {k, 1, n}] == Subscript[f, j], \
{j, 0, NN - 1}], {}] // Flatten;
T[x_] = Subscript[a, 0] + Sum[Subscript[a, k] Sin[k*x] + Subscript[b, k] \
Cos[k*x], {k, 1, n}] /. koef // Simplify
Table[PossibleZeroQ[T[Subscript[x, j]] - Subscript[f, j]], {j, 0, NN - 1}]
Gr1 = ListPlot[MapThread[List, {X, F}], PlotStyle -> {PointSize[0.02]}];
Gr2 = Plot[f[y], {y, Subscript[x, 0], Subscript[x, NN - 1]}];
Gr3 = Plot[T[y], {y, Subscript[x, 0], Subscript[x, NN - 1]}, PlotStyle -> Red];
Show[Gr1, Gr2, Gr3]
T[xx] // N
Abs[f[xx] - T[xx]]\
\>", "Input",ExpressionUUID->"138f3a8d-193c-d842-8dcb-9587023ed6c2"],

