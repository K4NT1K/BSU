Notebook[{
Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"b9725326-a408-e847-8ac8-2dc7a6264a99"],

Cell["\<\
\:041d\:0430\:0447\:0430\:043b\:044c\:043d\:044b\:0435 \:0434\:0430\:043d\
\:043d\:044b\:0435;
X = {0, Pi/12, Pi/6, Pi/4, Pi/3};
f[x_] = Tan[x];
n = Length[X] - 1;
Do[{Subscript[x, i] = X[[i + 1]], Subscript[f, i] = f[Subscript[x, i]]}, {i, \
0, n}]\
\>", "Input",ExpressionUUID->"9d2b9dcf-95ef-c547-96d8-157ab8517516"],

Cell["\<\
\:0410\:043b\:0433\:0435\:0431\:0440\:0430\:0438\:0447\:0435\:0441\:043a\:0438\
\:0439 \:0438\:043d\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\
\:043e\:043d\:043d\:044b\:0439 \:043c\:043d\:043e\:0433\:043e\:0447\:043b\
\:0435\:043d;
koef = Solve[Table[Subscript[a, 0] + Sum[Subscript[a, k] Subscript[x, j]^k, \
{k, 1, n}] == Subscript[f, j], {j, 0, n}], {}][[1]];
P[x_] = Sum[Subscript[a, k] x^k, {k, 0, n}] //. koef // Expand\
\>", "Input",ExpressionUUID->"c0b1723f-2370-654a-b31e-b8337c1e1b7f"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"112", " ", "x"}], "\[Pi]"], "-", 
  FractionBox[
   RowBox[{"63", " ", 
    SqrtBox["3"], " ", "x"}], "\[Pi]"], "-", 
  FractionBox[
   RowBox[{"1584", " ", 
    SuperscriptBox["x", "2"]}], 
   SuperscriptBox["\[Pi]", "2"]], "+", 
  FractionBox[
   RowBox[{"918", " ", 
    SqrtBox["3"], " ", 
    SuperscriptBox["x", "2"]}], 
   SuperscriptBox["\[Pi]", "2"]], "+", 
  FractionBox[
   RowBox[{"7200", " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]], "-", 
  FractionBox[
   RowBox[{"4176", " ", 
    SqrtBox["3"], " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]], "-", 
  FractionBox[
   RowBox[{"10368", " ", 
    SuperscriptBox["x", "4"]}], 
   SuperscriptBox["\[Pi]", "4"]], "+", 
  FractionBox[
   RowBox[{"6048", " ", 
    SqrtBox["3"], " ", 
    SuperscriptBox["x", "4"]}], 
   SuperscriptBox["\[Pi]", "4"]]}]], "Output",ExpressionUUID->"b28dbc01-490e-\
e34a-b4da-edf2837723e4"],

Cell["\<\
\:0421 \:043f\:043e\:043c\:043e\:0449\:044c\:044e \:0432\:0441\:0442\:0440\
\:043e\:0435\:043d\:043d\:043e\:0439 \:0444\:0443\:043d\:043a\:0446\:0438\
\:0438;
Tbl = Table[{Subscript[x, i], Subscript[f, i]}, {i, 0, n}];
P1[x_] = InterpolatingPolynomial[Tbl, x] // Expand\
\>", "Input",ExpressionUUID->"7ae75d0d-993d-f045-9e4d-914d1d088582"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"112", " ", "x"}], "\[Pi]"], "-", 
  FractionBox[
   RowBox[{"63", " ", 
    SqrtBox["3"], " ", "x"}], "\[Pi]"], "-", 
  FractionBox[
   RowBox[{"1584", " ", 
    SuperscriptBox["x", "2"]}], 
   SuperscriptBox["\[Pi]", "2"]], "+", 
  FractionBox[
   RowBox[{"918", " ", 
    SqrtBox["3"], " ", 
    SuperscriptBox["x", "2"]}], 
   SuperscriptBox["\[Pi]", "2"]], "+", 
  FractionBox[
   RowBox[{"7200", " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]], "-", 
  FractionBox[
   RowBox[{"4176", " ", 
    SqrtBox["3"], " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]], "-", 
  FractionBox[
   RowBox[{"10368", " ", 
    SuperscriptBox["x", "4"]}], 
   SuperscriptBox["\[Pi]", "4"]], "+", 
  FractionBox[
   RowBox[{"6048", " ", 
    SqrtBox["3"], " ", 
    SuperscriptBox["x", "4"]}], 
   SuperscriptBox["\[Pi]", "4"]]}]], "Output",ExpressionUUID->"7a8a474b-00ec-\
fe47-bb0d-527efea7ee56"],

Cell["\<\
\:0421\:0440\:0430\:0432\:043d\:0435\:043d\:0438\:0435;
P[x] == P1[x]\
\>", "Input",ExpressionUUID->"3289c4e8-997b-fd46-8d33-514812bc6443"],

Cell[BoxData["True"], "Output",ExpressionUUID->"3573ab9b-9f60-9b4e-8b4c-bcd72307d465"],

Cell["\<\
\:0418\:043d\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\:043e\:043d\
\:043d\:044b\:0435 \:0443\:0441\:043b\:043e\:0432\:0438\:044f;
Table[P[Subscript[x, i]] == Subscript[f, i], {i, 0, n}]\
\>", "Input",ExpressionUUID->"3cd79d8b-6a9b-4d4b-9f6f-d227de04a694"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output",ExpressionUUID->"30d081f4-36ee-a74a-ba49-f80aaa41c05b"],

Cell["\<\
\:0418\:0441\:0445\:043e\:0434\:043d\:044b\:0435 \:0442\:043e\:0447\:043a\
\:0438 \:0438 \:043f\:043e\:043b\:0443\:0447\:0435\:043d\:043d\:044b\:0439 \
\:0438\:043d\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\:043e\:043d\
\:043d\:044b\:0439 \:043c\:043d\:043e\:0433\:043e\:0447\:043b\:0435\:043d;
Gr1 = ListPlot[Tbl, PlotStyle -> {Black, PointSize[0.02]}];
Gr2 = Plot[f[x], {x, Subscript[x, 0], Subscript[x, n]}, PlotStyle -> \
RGBColor[0.44, 1, 0.4]];
Gr3 = Plot[P[x], {x, Subscript[x, 0], Subscript[x, n]}, PlotStyle -> {Gray, \
Dashed}];
Show[Gr1, Gr2, Gr3]\
\>", "Input",ExpressionUUID->"4e7efcb5-7eb0-5e46-840e-3c28cb7bff6a"],

