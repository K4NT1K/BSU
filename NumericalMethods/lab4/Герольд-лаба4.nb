\:043d\:0430;
n = k - 1;
P[x_] = Subscript[f, 0] + Sum[Subscript[r, m]*Product[(x - Subscript[x, i]), \
{i, 0, m - 1}], {m, 1, n}] // Expand\
\>", "Input",ExpressionUUID->"56c48f55-9d0f-6e43-b544-e4f3a1cdbdff"],

