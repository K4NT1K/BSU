Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"da821033-b415-9842-b24a-b0372756914e"],

Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 1", "Text",ExpressionUUID->"5f4ea908-a13d-fc47-a84c-1e6cda6d2e6d"],

Cell["\<\
1. \:0417\:0430\:0434\:0430\:0435\:043c \:043d\:0430\:0447\:0430\:043b\:044c\
\:043d\:044b\:0435 \:0434\:0430\:043d\:043d\:044b\:0435;
X = {0, Pi/6, Pi/4, Pi/3, Pi/2};
f[x_] = Cos[x]^2;\
\>", "Input",ExpressionUUID->"c23e4ea0-6c38-9c4a-be9e-33d0838d3415"],

Cell["\<\
2. \:0421\:0442\:0440\:043e\:0438\:043c \:0438\:043d\:0442\:0435\:0440\:043f\
\:043e\:043b\:044f\:0446\:0438\:043e\:043d\:043d\:044b\:0439 \:043c\:043d\
\:043e\:0433\:043e\:0447\:043b\:0435\:043d \:0432 \:0444\:043e\:0440\:043c\
\:0435 \:041b\:0430\:0433\:0440\:0430\:043d\:0436\:0430;
n = Length[X] - 1;
Do[Subscript[x, i] = X[[i + 1]], {i, 0, n}];
Do[Subscript[l, k][x_] = Product[(x - Subscript[x, i])/(Subscript[x, k] - \
Subscript[x, i]), {i, 0, k - 1}]*Product[(x - Subscript[x, i])/(Subscript[x, \
k] - Subscript[x, i]), {i, k + 1, n}], {k, 0, n}];
P[x_] = Sum[Subscript[l, k][x]*f[Subscript[x, k]], {k, 0, n}] // Expand\
\>", "Input",ExpressionUUID->"cf2edde8-c34b-f743-81f5-1529f7b8b41a"],

Cell[BoxData[
 RowBox[{"1", "+", 
  FractionBox["x", 
   RowBox[{"4", " ", "\[Pi]"}]], "-", 
  FractionBox[
   RowBox[{"27", " ", 
    SuperscriptBox["x", "2"]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], "+", 
  FractionBox[
   RowBox[{"18", " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]]}]], "Output",ExpressionUUID->"7884b8b3-eba2-\
da4d-b9b2-82eadc9f6670"],

Cell["\<\
3. \:0421\:0442\:0440\:043e\:0438\:043c \:0438\:043d\:0442\:0435\:0440\:043f\
\:043e\:043b\:044f\:0446\:0438\:043e\:043d\:043d\:044b\:0439 \:043c\:043d\
\:043e\:0433\:043e\:0447\:043b\:0435\:043d \:0432 \:0444\:043e\:0440\:043c\
\:0435 \:041d\:044c\:044e\:0442\:043e\:043d\:0430;
H[x_] = f[Subscript[x, 0]] + Sum[Sum[f[Subscript[x, \
k]]/((Product[(Subscript[x, k] - Subscript[x, i]), {i, 0, k - \
1}])*(Product[(Subscript[x, k] - Subscript[x, i]), {i, k + 1, j}])), {k, 0, \
j}]*Product[(x - Subscript[x, m]), {m, 0, j - 1}], {j, 1, n}] // Expand\
\>", "Input",ExpressionUUID->"963a7f6a-344f-f747-ae5b-8bc85b840b93"],

Cell[BoxData[
 RowBox[{"1", "+", 
  FractionBox["x", 
   RowBox[{"4", " ", "\[Pi]"}]], "-", 
  FractionBox[
   RowBox[{"27", " ", 
    SuperscriptBox["x", "2"]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], "+", 
  FractionBox[
   RowBox[{"18", " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]]}]], "Output",ExpressionUUID->"93c9e28f-04d1-\
b741-bcc7-d9e988f80455"],

Cell["\<\
4. \:041a\:043e\:043d\:0442\:0440\:043e\:043b\:044c\:043d\:044b\:0439 \:043c\
\:043d\:043e\:0433\:043e\:0447\:043b\:0435\:043d InterpolatingPolynomial;
Tbl = Table[{Subscript[x, i], f[Subscript[x, i]]}, {i, 0, n}];
P1[x_] = InterpolatingPolynomial[Tbl, x] // Expand\
\>", "Input",ExpressionUUID->"94946ab8-b7ff-6a46-84a4-d9b62114d088"],

Cell[BoxData[
 RowBox[{"1", "+", 
  FractionBox["x", 
   RowBox[{"4", " ", "\[Pi]"}]], "-", 
  FractionBox[
   RowBox[{"27", " ", 
    SuperscriptBox["x", "2"]}], 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], "+", 
  FractionBox[
   RowBox[{"18", " ", 
    SuperscriptBox["x", "3"]}], 
   SuperscriptBox["\[Pi]", "3"]]}]], "Output",ExpressionUUID->"70b81f24-d664-\
5649-87d1-c386bb9d4475"],

Cell["\<\
5. \:0421\:0440\:0430\:0432\:043d\:0438\:0432\:0430\:0435\:043c \:0432\:0441\
\:0435 \:043f\:043e\:043b\:0443\:0447\:0435\:043d\:043d\:044b\:0435 \:0438\
\:043d\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\:043e\:043d\:043d\
\:044b\:0435 \:043c\:043d\:043e\:0433\:043e\:0447\:043b\:0435\:043d\:044b;
P[x] == H[x] == P1[x]\
\>", "Input",ExpressionUUID->"982863d9-4400-ec43-9af2-2c902ec6829a"],

Cell[BoxData["True"], "Output",ExpressionUUID->"d3d50924-3fc0-534a-8456-61a9512a8901"],

Cell["\<\
6. \:041f\:0440\:043e\:0432\:0435\:0440\:044f\:0435\:043c \:0441\:0432\:043e\
\:0439\:0441\:0442\:0432\:043e \:0438\:043d\:0432\:0430\:0440\:0438\:0430\
\:043d\:0442\:043d\:043e\:0441\:0442\:0438 \:0444\:043e\:0440\:043c\:0443\
\:043b\:044b \:041b\:0430\:0433\:0440\:0430\:043d\:0436\:0430;
Unprotect[Power]; 0^0 := 1;
Table[x^j === (Sum[Subscript[l, k][x]*Subscript[x, k]^j, {k, 0, n}] // \
Expand), {j, 0, n}]
x^(n + 1) === (Sum[Subscript[l, k][x]*Subscript[x, k]^(n + 1), {k, 0, n}] // \
Expand)\
\>", "Input",ExpressionUUID->"39331adb-3959-6d49-b261-e8b9af4d242a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output",ExpressionUUID->"9514d5c0-782f-5d4c-8d2e-8697a69fd5e9"],

Cell[BoxData["False"], "Output",ExpressionUUID->"5cc836a6-2a03-fa47-b2f6-1431692aa1e6"],

Cell["\<\
7. \:041d\:0430\:0445\:043e\:0434\:0438\:043c \:043f\:0440\:0438\:0431\:043b\
\:0438\:0436\:0435\:043d\:043d\:043e\:0435 \:0437\:043d\:0430\:0447\:0435\
\:043d\:0438\:0435 \:0444\:0443\:043d\:043a\:0446\:0438\:0438 \:0432 \:0443\
\:043a\:0430\:0437\:0430\:043d\:043d\:043e\:0439 \:0442\:043e\:0447\:043a\
\:0435;
Subscript[x, n + 1] = Pi/9;
P[Subscript[x, n + 1]]\
\>", "Input",ExpressionUUID->"7c92fc64-5af5-3841-878e-4addf2ea48e0"],

Cell[BoxData[
 FractionBox["287", "324"]], "Output",ExpressionUUID->"311574e8-baa3-6348-bbf0-fc604760ba7f"],

Cell["\<\
8. \:0412\:044b\:0447\:0438\:0441\:043b\:044f\:0435\:043c \:043f\:043e\:0433\
\:0440\:0435\:0448\:043d\:043e\:0441\:0442\:044c \:0434\:0432\:0443\:043c\
\:044f \:0441\:043f\:043e\:0441\:043e\:0431\:0430\:043c\:0438;
R1 = f[Subscript[x, n + 1]] - P[Subscript[x, n + 1]]
R2 = Sum[f[Subscript[x, k]]/((Product[(Subscript[x, k] - Subscript[x, i]), \
{i, 0, k - 1}])*(Product[(Subscript[x, k] - Subscript[x, i]), {i, k + 1, n + \
1}])), {k, 0, n + 1}]*Product[(Subscript[x, n + 1] - Subscript[x, j]), {j, 0, \
n}] // Expand
R1 == R2\
\>", "Input",ExpressionUUID->"708b3cf1-db92-2945-8ed4-1c37d64fcbd0"],

