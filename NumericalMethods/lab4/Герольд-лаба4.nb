Cell["\<\
2. \:041d\:0430\:0445\:043e\:0434\:0438\:043c \:043d\:0435\:043e\:0431\:0445\
\:043e\:0434\:0438\:043c\:043e\:0435 \:0447\:0438\:0441\:043b\:043e \:0443\
\:0437\:043b\:043e\:0432;
Subscript[x, 0] = 1; Subscript[x, 1] = 2; Subscript[f, 0] = f[Subscript[x, \
0]]; Subscript[f, 1] = f[Subscript[x, 1]];
k = 1;
While[(Subscript[r, k] = Sum[Subscript[f, j]/((Product[(Subscript[x, j] - \
Subscript[x, i]), {i, 0, j - 1}])*(Product[(Subscript[x, j] - Subscript[x, \
i]), {i, j + 1, k}])), {j, 0, k}]) != 0, {k = k + 1, Subscript[x, k] = k + 1, \
Subscript[f, k] = f[Subscript[x, k]]}];
k\
\>", "Input",ExpressionUUID->"a45fc549-d134-4245-92ef-b96f05a57f7f"],

Cell[BoxData["6"], "Output",ExpressionUUID->"db493e5c-80fe-0a45-9fc5-2a67b3c43de1"],

Cell["\<\
