Cell["\<\
8. \:0423\:0431\:0435\:0436\:0434\:0430\:0435\:043c\:0441\:044f \:0447\:0442\
\:043e \:043f\:043e\:0433\:0440\:0435\:0448\:043d\:043e\:0441\:0442\:044c \
\:043d\:0435 \:043f\:0440\:0435\:0432\:043e\:0441\:0445\:043e\:0434\:0438\
\:0442 \:043e\:0446\:0435\:043d\:043a\:0438;
MR1 = Maximize[{f[x] - P[x], Subscript[x, 0] <= x <= Subscript[x, n]}, x][[1]];
MR2 = Minimize[{f[x] - P[x], Subscript[x, 0] <= x <= Subscript[x, n]}, x][[1]];
MR = Max[{Abs[MR1], Abs[MR2]}];
MR <= R\
\>", "Input",ExpressionUUID->"cb6c95ba-ca15-af44-ad29-9b153acf6d7a"],

