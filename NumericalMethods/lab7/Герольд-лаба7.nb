InterpolatingPolynomial[Table[{Subscript[x, i], Table[D[g[t], {t, s}] /. t -> \
Subscript[x, i], {s, 0, m}]}, {i, 0, n}], t]; {t^jj, Expand[g[t] - Ht[t]] === \
0}], {jj, 0, NN + 1}]\
\>", "Input",ExpressionUUID->"db333c79-7f25-8d4b-8069-12818fc2a006"],

