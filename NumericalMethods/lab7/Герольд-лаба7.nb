Notebook[{
Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"b6d9f0ad-93a0-534a-8981-12269aa14dc4"],

Cell["\<\
1. \:0417\:0430\:0434\:0430\:0435\:043c \:043d\:0430\:0447\:0430\:043b\:044c\
\:043d\:044b\:0435 \:0434\:0430\:043d\:043d\:044b\:0435;
Subscript[x, 0] = 0; Subscript[x, 1] = Pi/4; Subscript[x, 2] = Pi/2; n = 2;
f[x_] = Sin[x]^2*Cos[x];
m = 3;
NN = (m + 1)*(n + 1) - 1;\
\>", "Input",ExpressionUUID->"6fee338c-0c4b-534e-b083-87829a18c4e6"],

Cell["\<\
2. \:0421\:0442\:0440\:043e\:0438\:043c \:0438\:043d\:0442\:0435\:0440\:043f\
\:043e\:043b\:044f\:0446\:0438\:043e\:043d\:043d\:044b\:0439 \:043c\:043d\
\:043e\:0433\:043e\:0447\:043b\:0435\:043d \:042d\:0440\:043c\:0438\:0442\
\:0430;
P[x_] = Sum[Subscript[a, k] x^k, {k, 0, NN}];
eqv = Table[(D[P[x], {x, j}] /. x -> Subscript[x, k]) == (D[f[x], {x, j}] /. \
x -> Subscript[x, k]), {j, 0, m}, {k, 0, n}] // Flatten;
koef = Solve[eqv, {}] // Flatten;
P[x_] = P[x] //. koef // Expand // N[#, 16]&\
\>", "Input",ExpressionUUID->"5837d631-cf73-e04a-9294-1772e8a206ba"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", "2"], "-", 
  RowBox[{"0.83365088684866724422354153075486828663`16.", " ", 
   SuperscriptBox["x", "4"]}], "+", 
  RowBox[{"0.00230833315893234626605967658250767032`16.", " ", 
   SuperscriptBox["x", "5"]}], "+", 
