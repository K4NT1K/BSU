Cell["\<\
6. \:041e\:0446\:0435\:043d\:043a\:0430 \:043f\:043e\:0433\:0440\:0435\:0448\
\:043d\:043e\:0441\:0442\:0438;
M1 = Maximize[{D[f[x], {x, NN + 1}], Subscript[x, 0] <= x <= Subscript[x, \
n]}, x][[1]];
M2 = Minimize[{D[f[x], {x, NN + 1}], Subscript[x, 0] <= x <= Subscript[x, \
n]}, x][[1]];
M = Max[{Abs[M1], Abs[M2]}];
omega[t_] = Product[(t - Subscript[x, i])^(m + 1), {i, 0, n}];
Momega = Maximize[{Abs[omega[x]], Subscript[x, 0] <= x <= Subscript[x, n]}, \
x][[1]];
R = M/((NN + 1)!) * Momega // N
Print[\"\:041e\:0442\:0432\:0435\:0442: \:043e\:0446\:0435\:043d\:043a\:0430 \
\:043f\:043e\:0433\:0440\:0435\:0448\:043d\:043e\:0441\:0442\:0438 R = \", R]\
\
\>", "Input",ExpressionUUID->"ff97cfe4-549b-154b-a6f3-8157696f6a25"],

Cell[BoxData[
 TemplateBox[{
  "\"\:041e\:0442\:0432\:0435\:0442: \:043e\:0446\:0435\:043d\:043a\:0430 \
\:043f\:043e\:0433\:0440\:0435\:0448\:043d\:043e\:0441\:0442\:0438 R = \"", 
   "3.353741157042591`*^-7"},
  "RowDefault"]], "Print",ExpressionUUID->"f7f6e7ec-dbdc-6e47-bf58-\
643ffb0afc91"],

Cell[BoxData["3.353741157042591`*^-7"], "Output",ExpressionUUID->"d0b167e2-8deb-a042-9b8f-469ae2643ce6"],

Cell["\<\
7. \:0413\:0440\:0430\:0444\:0438\:043a\:0438 \:0430\:0431\:0441\:043e\:043b\
\:044e\:0442\:043d\:043e\:0439 \:043f\:043e\:0433\:0440\:0435\:0448\:043d\
\:043e\:0441\:0442\:0438 \:0438 \:043e\:0446\:0435\:043d\:043a\:0438;
Gr3 = Plot[Abs[f[x] - P[x]], {x, Subscript[x, 0], Subscript[x, n]}];
Gr4 = Plot[R, {x, Subscript[x, 0], Subscript[x, n]}, PlotStyle -> Red];
Show[Gr3, Gr4, PlotRange -> Automatic]\
\>", "Input",ExpressionUUID->"f9ef4f23-c7f0-dc4d-8729-65f7d2a8e660"],

