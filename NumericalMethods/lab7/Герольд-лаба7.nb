   SuperscriptBox["x", "7"]}], "-", 
  RowBox[{"0.05178294615415484119025708680811772308`16.", " ", 
   SuperscriptBox["x", "8"]}], "+", 
  RowBox[{"0.00549471347856008081486551154155588006`16.", " ", 
   SuperscriptBox["x", "9"]}], "+", 
  RowBox[{"0.00344620141585422283016532824646875372`16.", " ", 
   SuperscriptBox["x", "10"]}], "-", 
  RowBox[{"0.00067992563059514459348919524867249941`16.", " ", 
   SuperscriptBox["x", "11"]}]}]], "Output",ExpressionUUID->"c2db7018-c58b-\
2e42-826d-52955487c4cf"],

Cell["\<\
3. \:041f\:0440\:043e\:0432\:0435\:0440\:044f\:0435\:043c \:0432\:044b\:043f\
\:043e\:043b\:043d\:0435\:043d\:0438\:0435 \:0438\:043d\:0442\:0435\:0440\
\:043f\:043e\:043b\:044f\:0446\:0438\:043e\:043d\:043d\:044b\:0445 \:0443\
\:0441\:043b\:043e\:0432\:0438\:0439;
Table[((D[P[x], {x, j}] /. x -> Subscript[x, k]) - (D[f[x], {x, j}] /. x -> \
Subscript[x, k]) // Chop) == 0, {j, 0, m}, {k, 0, n}]\
\>", "Input",ExpressionUUID->"7e4c079a-5544-fd46-960b-431325b0bae0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"True", ",", "True", ",", "True"}], "}"}]}], "}"}]], "Output",Expr\
essionUUID->"bd22c38e-317f-e44d-a748-f5323512166a"],

Cell["\<\
4. \:041a\:043e\:043d\:0442\:0440\:043e\:043b\:044c \:0447\:0435\:0440\:0435\
\:0437 InterpolatingPolynomial;
Tbl = Table[{Subscript[x, i], Table[D[f[x], {x, j}] /. x -> Subscript[x, i], \
{j, 0, m}]}, {i, 0, n}];
P1[x_] = InterpolatingPolynomial[Tbl, x] // Expand;
N[P[x] - P1[x]] // Chop\
\>", "Input",ExpressionUUID->"39ba4911-3628-a045-9388-cfe80ecdd5a3"],

Cell[BoxData["0"], "Output",ExpressionUUID->"06e47e1c-95f0-c144-b4a4-0d82112413c1"],

Cell["\<\
5. \:0418\:0437\:043e\:0431\:0440\:0430\:0436\:0430\:0435\:043c \:0442\:043e\
\:0447\:043a\:0438 \:0438 \:043c\:043d\:043e\:0433\:043e\:0447\:043b\:0435\
\:043d;
Tb = Table[{Subscript[x, i], f[Subscript[x, i]]}, {i, 0, n}];
Gr1 = ListPlot[Tb, PlotStyle -> {PointSize[0.02]}];
Gr2 = Plot[P[x], {x, Subscript[x, 0], Subscript[x, n]}];
Show[Gr1, Gr2]\
\>", "Input",ExpressionUUID->"0b996e48-25d3-334b-81a0-c115f94a5db6"],

