Notebook[{
Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"8d2c3b78-1ca9-064b-8363-f53fcab2dc91"],

Cell["\:0417\:0430\:0434\:0430\:043d\:0438\:0435 1", "Text",ExpressionUUID->"b85fa5cd-ff8b-a24c-aec8-32e310e4f51d"],

Cell["\<\
\:041d\:0430\:0447\:0430\:043b\:044c\:043d\:044b\:0435 \:0434\:0430\:043d\
\:043d\:044b\:0435;
X = {0, Pi/12, Pi/6, Pi/4, Pi/3};
f[x_] = Tan[x];
n = Length[X] - 1;
Do[{Subscript[x, i] = X[[i + 1]], Subscript[f, i] = f[Subscript[x, i]]}, {i, \
0, n}]\
\>", "Input",ExpressionUUID->"7f6ac9a9-105c-f947-8ece-9730f00013cd"],

Cell["\<\
\:0410\:043b\:0433\:0435\:0431\:0440\:0430\:0438\:0447\:0435\:0441\:043a\:0438\
\:0439 \:0438\:043d\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\
\:043e\:043d\:043d\:044b\:0439 \:043c\:043d\:043e\:0433\:043e\:0447\:043b\
\:0435\:043d \:0447\:0435\:0440\:0435\:0437 \:043e\:043f\:0440\:0435\:0434\
\:0435\:043b\:0438\:0442\:0435\:043b\:044c \:0412\:0430\:043d\:0434\:0435\
\:0440\:043c\:043e\:043d\:0434\:0430;
Unprotect[Power]; 0^0 := 1;
Do[Subscript[fi, j][x_] = x^j, {j, 0, n}];
Do[Subscript[d, i, j] = Subscript[fi, j][Subscript[x, i]], {i, 0, n}, {j, 0, \
n}];
Do[{Subscript[d, i, n + 1] = Subscript[f, i], Subscript[d, n + 1, i] = \
Subscript[fi, i][x]}, {i, 0, n}];
Subscript[d, n + 1, n + 1] = 0;
V = Table[Subscript[d, i, j], {i, 0, n}, {j, 0, n}];
V1 = Table[Subscript[d, i, j], {i, 0, n + 1}, {j, 0, n + 1}];
V1 // MatrixForm
P[x_] = -Det[V1]/Det[V] // Expand\
\>", "Input",ExpressionUUID->"c9977179-5b9f-2645-8d97-234673849b81"],

