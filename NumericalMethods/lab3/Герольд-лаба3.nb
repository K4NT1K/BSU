Cell["\<\
\:0418\:043d\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\:043e\:043d\
\:043d\:044b\:0435 \:0443\:0441\:043b\:043e\:0432\:0438\:044f;
Table[P[Subscript[x, i]] == Subscript[f, i], {i, 0, n}]\
\>", "Input",ExpressionUUID->"61201dee-2c73-3848-833e-f31a9cf52684"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output",ExpressionUUID->"ba2413c2-0ace-c641-ae88-cf6f06f3df08"],

Cell["\<\
\:0421 \:043f\:043e\:043c\:043e\:0449\:044c\:044e \:0432\:0441\:0442\:0440\
\:043e\:0435\:043d\:043d\:043e\:0439 \:0444\:0443\:043d\:043a\:0446\:0438\
\:0438 InterpolatingPolynomial;
Tbl = Table[{Subscript[x, i], Subscript[f, i]}, {i, 0, n}];
P1[x_] = InterpolatingPolynomial[Tbl, x] // Expand
P[x] == P1[x]\
\>", "Input",ExpressionUUID->"3738f385-5b13-3147-9366-19a7401c80c8"],

