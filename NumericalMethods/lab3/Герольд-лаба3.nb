Cell["\<\
\:0418\:0441\:0445\:043e\:0434\:043d\:044b\:0435 \:0442\:043e\:0447\:043a\
\:0438 \:0438 \:0444\:0443\:043d\:043a\:0446\:0438\:044f \:0438 \:0438\:043d\
\:0442\:0435\:0440\:043f\:043e\:043b\:044f\:0446\:0438\:043e\:043d\:043d\:044b\
\:0439 \:043c\:043d\:043e\:0433\:043e\:0447\:043b\:0435\:043d;
Gr1 = ListPlot[Tbl, PlotStyle -> {Black, PointSize[0.02]}];
Gr2 = Plot[f[x], {x, Subscript[x, 0], Subscript[x, n]}, PlotStyle -> \
RGBColor[0.44, 1, 0.4]];
Gr3 = Plot[P[x], {x, Subscript[x, 0], Subscript[x, n]}, PlotStyle -> {Gray, \
Dashed}];
Show[Gr1, Gr2, Gr3]\
\>", "Input",ExpressionUUID->"aa77aa81-7519-874c-846e-cbf8e39401fd"],

