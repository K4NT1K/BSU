Notebook[{
Cell["\:0412\:0430\:0440\:0438\:0430\:043d\:0442 3;", "Input",ExpressionUUID->"cac75b78-8648-664e-814e-496a94d01adf"],

Cell["\:041b\:0438\:043d\:0435\:0439\:043d\:044b\:0439 \:0441\:043f\:043b\
\:0430\:0439\:043d, m = 1", "Text",ExpressionUUID->"e8f5014f-4f14-ca4e-833d-\
5249029d0813"],

Cell["\<\
Clear[P, PP, PPP, A, B, eq, koef, T, X, F, NN, n, xx, spl1, spl2, spl3];
1. \:0417\:0430\:0434\:0430\:0435\:043c \:043d\:0430\:0447\:0430\:043b\:044c\
\:043d\:044b\:0435 \:0434\:0430\:043d\:043d\:044b\:0435;
Subscript[x, 0] = 1; Subscript[x, 1] = 3; Subscript[x, 2] = 5; Subscript[x, \
3] = 8;
Subscript[f, 0] = 4; Subscript[f, 1] = -20; Subscript[f, 2] = 45; \
Subscript[f, 3] = 76;
n = 3;\
\>", "Input",ExpressionUUID->"69ff9907-8382-224c-b9f2-54a4a8703cc1"],

Cell["\<\
2. \:0424\:043e\:0440\:043c\:0438\:0440\:0443\:0435\:043c \:043b\:0438\:043d\
\:0435\:0439\:043d\:044b\:0439 \:0438\:043d\:0442\:0435\:0440\:043f\:043e\
\:043b\:044f\:0446\:0438\:043e\:043d\:043d\:044b\:0439 \:0441\:043f\:043b\
\:0430\:0439\:043d;
Subscript[P, k_][t_] = Subscript[f, k] + (t - Subscript[x, k])*Subscript[A, k];
eq1 = Table[Subscript[P, k][Subscript[x, k + 1]] == Subscript[P, k + \
1][Subscript[x, k + 1]], {k, 0, n - 2}];
eq2 = {Subscript[P, n - 1][Subscript[x, n]] == Subscript[f, n]};
eq = Join[eq1, eq2]
koef = Solve[eq, {}]
spl1 = Table[Subscript[P, k][t] /. koef, {k, 0, n - 1}] // Expand // Flatten
Table[(spl1[[k]] /. t -> Subscript[x, k - 1]) == Subscript[f, k - 1], {k, 1, \
n}]
(spl1[[n]] /. t -> Subscript[x, n]) == Subscript[f, n]\
\>", "Input",ExpressionUUID->"8c136a9b-b161-9940-915e-f1cd2ddb3005"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"4", "+", 
     RowBox[{"2", " ", 
      SubscriptBox["A", "0"]}]}], "\[Equal]", 
    RowBox[{"-", "20"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "20"}], "+", 
     RowBox[{"2", " ", 
      SubscriptBox["A", "1"]}]}], "\[Equal]", "45"}], ",", 
   RowBox[{
    RowBox[{"45", "+", 
     RowBox[{"3", " ", 
      SubscriptBox["A", "2"]}]}], "\[Equal]", "76"}]}], "}"}]], "Output",Expre\
ssionUUID->"837c4b7c-b2f6-cf40-8995-7528ef87c146"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox["A", "0"], "\[Rule]", 
     RowBox[{"-", "12"}]}], ",", 
    RowBox[{
     SubscriptBox["A", "1"], "\[Rule]", 
     FractionBox["65", "2"]}], ",", 
    RowBox[{
     SubscriptBox["A", "2"], "\[Rule]", 
     FractionBox["31", "3"]}]}], "}"}], "}"}]], "Output",ExpressionUUID->\
"dbaba2d3-481a-7747-afbf-24bfa1f3e9d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"16", "-", 
    RowBox[{"12", " ", "t"}]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["235", "2"]}], "+", 
    FractionBox[
     RowBox[{"65", " ", "t"}], "2"]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["20", "3"]}], "+", 
    FractionBox[
     RowBox[{"31", " ", "t"}], "3"]}]}], "}"}]], "Output",ExpressionUUID->\
"06da3c0a-1c81-5d46-a2eb-68afbd284c2f"],

