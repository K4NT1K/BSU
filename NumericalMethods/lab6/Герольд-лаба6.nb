Cell[BoxData["True"], "Output",ExpressionUUID->"5d1e32b8-8381-2948-b7f1-3087edf7682f"],

Cell["\<\
GrA = ListPlot[Table[{Subscript[x, i], Subscript[f, i]}, {i, 0, n}], \
PlotStyle -> {PointSize[0.02]}];
GrB = Table[Plot[spl1[[k]], {t, Subscript[x, k - 1], Subscript[x, k]}], {k, \
1, n}];
Show[GrA, GrB]\
\>", "Input",ExpressionUUID->"b10d7a3c-4eae-894b-aefe-1a5bf96c5f11"],

